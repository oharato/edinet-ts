{
  "name": "edinet-ts",
  "version": "2.0.0",
  "description": "EDINET XBRL financial metrics extractor & DuckDB screening tool",
  "keywords": [
    "duckdb",
    "edinet",
    "financial-screening",
    "operating-margin",
    "typescript",
    "xbrl"
  ],
  "license": "Apache-2.0",
  "author": "oharato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oharato/edinet-ts.git"
  },
  "bin": {
    "edinet-ts": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc",
    "test": "vitest run test/*.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "2.0.0-r.1"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.13.0",
  "allowScripts": {
    "esbuild": true
  }
}
